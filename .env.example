DB_HOST=localhost
DB_DATABASE=
DB_NAME=
DB_ENTITIES=dist/src/modules/**/entities/**/*.entity{.ts,.js}
DB_MIGRATIONS=dist/db/migrations/*{.ts,.js}

JWT_SECRET=someSecrets
JWT_EXPIRY_TIMEFRAME=3600

ADMIN_SECRET_KEY=sometext

GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SERVER_NAME=api
SMTP_USER=
SMTP_PASSWORD=

RATE_LIMIT_GLOBAL=100
RATE_LIMIT_WINDOW_SEC=900
RATE_LIMIT_SENSITIVE=5
RATE_LIMIT_SENSITIVE_WINDOW_SEC=900
# Comma-separated proxy IPs. X-Forwarded-For is used only if the socket peer matches.
# TRUSTED_PROXIES=
# Resend SMTP (takes precedence over SMTP_* vars above when set)
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend
RESEND_SMTP_API_KEY=
MAIL_FROM="FlowBrand <flowbrand@hng14.com>"
